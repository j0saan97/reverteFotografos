{
  "name": "galeria-fotos",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\"",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > apps/web/src/types/database.ts",
    "fn:serve": "supabase functions serve",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:types:remote": "supabase gen types typescript --linked > apps/web/src/types/database.ts",
    "fn:deploy": "supabase functions deploy"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^3.2.0",
    "typescript": "^5.5.4"
  }
}
